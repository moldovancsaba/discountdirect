# Never commit real values. Names only; values live in .env.local and the Vercel/GitHub secret stores.
# Preserve an existing .env.local; use this file only to create a missing one.
# GDS installs from its public release bundle, so no registry token is needed for pnpm install.
# Also read by code but provided by the platform, not set here: NODE_ENV, VERCEL_URL, VERCEL_PROJECT_PRODUCTION_URL,
# VERCEL_ENV, VERCEL_REGION, VERCEL_DEPLOYMENT_ID and (Blob alternative) VERCEL_OIDC_TOKEN.

# --- Database ---
# Required. MongoDB Atlas connection string; runtime fails closed without it.
MONGODB_URI=
# Optional. Database name; the code defaults to "discountdirect".
MONGODB_DB=discountdirect

# --- Application ---
# Required for checkout hand-off (and as the e-mail/postal public base URL fallback).
APP_URL=http://localhost:3000
# Optional. Realtime sockets are on only when this is exactly "true"; durable HTTP conversations work either way.
REALTIME_ENABLED=false

# --- Operations and cron ---
# Required for /api/health/ready and the ops scripts. Server-only readiness-probe token; never grants a human login. Use at least 32 characters.
OPERATIONS_TOKEN=
# Required for /api/cron/* (sent as a bearer token by Vercel Cron).
CRON_SECRET=

# --- Authentication (DoneIsBetter SSO) ---
# Required for human sign-in.
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
# Optional. The code defaults to https://sso.doneisbetter.com.
SSO_ORIGIN=https://sso.doneisbetter.com
# Required. The two callback URLs registered with the SSO client.
SSO_REDIRECT1_URI=http://localhost:3000/auth/callback
SSO_REDIRECT2_URI=http://localhost:3000/api/oauth/callback

# --- Checkout hand-off ---
# Required for hand-off. Signing secret, at least 32 characters.
HANDOFF_SIGNING_SECRET=
# Optional kill switch. Hand-off is enabled unless this is exactly "false".
HANDOFF_ENABLED=true

# --- Commerce connectors ---
# Optional. JSON secret: {"clientId":"...","clientSecret":"..."}. Store only this variable name in a connector installation.
SHOPRENTER_CONNECTOR_CREDENTIALS=
# Required for Shoprenter order callbacks. Unique secret, at least 32 characters.
SHOPRENTER_WEBHOOK_SECRET=
# Optional. JSON secret: {"apiKey":"..."}. Store only this variable name in a connector installation.
UNAS_CONNECTOR_CREDENTIALS=

# --- E-mail delivery (Resend) ---
# Optional. Empty disables sending; "resend" is the only supported provider.
EMAIL_DELIVERY_PROVIDER=
# Optional. Public base URL for e-mail links; falls back to APP_URL.
EMAIL_PUBLIC_BASE_URL=
# Optional. Comma-separated recipient allow-list; empty means no staging restriction.
EMAIL_STAGED_RECIPIENTS=
# Optional. Signs unsubscribe links; falls back to RESEND_WEBHOOK_SECRET.
EMAIL_UNSUBSCRIBE_SECRET=
# Required when EMAIL_DELIVERY_PROVIDER=resend: these four, plus a public base URL (EMAIL_PUBLIC_BASE_URL or APP_URL).
RESEND_API_KEY=
RESEND_FROM=
RESEND_REPLY_DOMAIN=
RESEND_WEBHOOK_SECRET=
# Optional. Provider API base URL; the code defaults to https://api.resend.com.
RESEND_API_BASE_URL=

# --- Private artifacts (Vercel Blob) ---
# Needed for artifact and PDF flows: either BLOB_READ_WRITE_TOKEN, or Vercel OIDC plus BLOB_STORE_ID.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=

# --- Redis acceleration (Upstash) ---
# Optional. Counters, rate limits and locks degrade to MongoDB-only operation when absent.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Postal delivery provider (disabled unless every value below is valid) ---
# "http" enables the provider-neutral adapter; empty keeps manual seller fulfillment only.
POSTAL_DELIVERY_PROVIDER=
# HTTPS endpoint of the provider.
POSTAL_PROVIDER_ENDPOINT=
# Bearer token, at least 16 characters.
POSTAL_PROVIDER_TOKEN=
# Callback signing secret, at least 32 characters.
POSTAL_PROVIDER_WEBHOOK_SECRET=
# HTTPS public base URL. The code falls back to APP_URL only when this variable is unset (not empty); pnpm release:readiness requires it to be set.
POSTAL_PUBLIC_BASE_URL=

# --- Package registry ---
# Optional and not read by application code; kept for GitHub Packages delivery if it is ever used again.
GITHUB_TOKEN=

# --- Script-only ---
# Optional. Target for pnpm test:smoke (default http://localhost:3000); ops:monitor and test:quality-release default to the production alias.
# SMOKE_BASE_URL=
