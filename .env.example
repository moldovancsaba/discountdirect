# Never commit real values. GDS installs from its public release bundle; GITHUB_TOKEN is optional.
MONGODB_URI=
MONGODB_DB=discountdirect
REALTIME_ENABLED=false
APP_URL=http://localhost:3000
HANDOFF_SIGNING_SECRET=
HANDOFF_ENABLED=true
# JSON secret: {"clientId":"...","clientSecret":"..."}. Store only this variable name in a connector installation.
SHOPRENTER_CONNECTOR_CREDENTIALS=
SHOPRENTER_WEBHOOK_SECRET=
# JSON secret: {"apiKey":"..."}. Store only this variable name in a connector installation.
UNAS_CONNECTOR_CREDENTIALS=
EMAIL_DELIVERY_PROVIDER=
EMAIL_PUBLIC_BASE_URL=
EMAIL_STAGED_RECIPIENTS=
EMAIL_UNSUBSCRIBE_SECRET=
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
RESEND_API_KEY=
RESEND_API_BASE_URL=
RESEND_FROM=
RESEND_REPLY_DOMAIN=
RESEND_WEBHOOK_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
GITHUB_TOKEN=
# Server-only readiness-probe token; this never grants a human login. Use at least 32 characters.
OPERATIONS_TOKEN=
CRON_SECRET=
POSTAL_DELIVERY_PROVIDER=
POSTAL_PROVIDER_ENDPOINT=
POSTAL_PROVIDER_TOKEN=
POSTAL_PROVIDER_WEBHOOK_SECRET=
POSTAL_PUBLIC_BASE_URL=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_ORIGIN=https://sso.doneisbetter.com
SSO_REDIRECT1_URI=http://localhost:3000/auth/callback
SSO_REDIRECT2_URI=http://localhost:3000/api/oauth/callback
