{
  "name": "discountdirect",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "db:check": "node --env-file=.env.local scripts/check-db.mjs",
    "lint": "eslint .",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "test:smoke": "node --env-file=.env.local scripts/smoke.mjs",
    "test:auth-integration": "node --experimental-strip-types --env-file=.env.local scripts/verify-auth.ts",
    "db:indexes": "node --experimental-strip-types --env-file=.env.local scripts/create-auth-indexes.ts",
    "auth:provision": "node --experimental-strip-types --env-file=.env.local scripts/provision-user.ts"
  },
  "dependencies": {
    "mongoose": "9.9.5",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "24.12.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@10.30.3"
}
